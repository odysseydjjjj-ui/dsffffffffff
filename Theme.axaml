<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="UserControl.page">
    <Style.Animations>
      <Animation Duration="0:0:0.38" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="RenderTransform" Value="translateY(22px)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="translateY(0px)" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        <BrushTransition Property="Background" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
    <Setter Property="BorderBrush" Value="#5B5B66" />
    <Setter Property="Background" Value="#1C1C20" />
  </Style>
  <Style Selector="Border.flat">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A2A32" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#5B5B66" />
  </Style>
  <Style Selector="Button.pill:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A78BFA" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.icon:pressed">
    <Setter Property="RenderTransform" Value="scale(0.88)" />
  </Style>

  <Style Selector="Button.win">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.win:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>
  <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E81123" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="#1A1A1E" />
    <Setter Property="Foreground" Value="#C9C9D1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26262C" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="RadioButton.nav">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" RenderTransform="scale(1)">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.18" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav Image">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav TextBlock">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#Box">
    <Setter Property="Background" Value="#1A1A1E" />
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>
  <Style Selector="RadioButton.nav:pointerover Image">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#Box">
    <Setter Property="Background" Value="#1F1F24" />
    <Setter Property="BorderBrush" Value="White" />
  </Style>
  <Style Selector="RadioButton.nav:checked Image">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="RadioButton.nav:checked TextBlock">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBlock.w">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
