<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Trackify.Controls" x:Class="Trackify.Views.ChatsPage" Classes="page">
  <Grid ColumnDefinitions="230,*" Margin="0">
    <Border BorderBrush="#222228" BorderThickness="0,0,1,0" Padding="14,18">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Chats" />
        <ItemsControl Name="Friends">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Padding="10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Grid Width="34" Height="34">
                    <Ellipse Fill="#2A2A32" />
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    <Image Source="{Binding StatusIcon}" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Grid>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Image Source="{Binding RoleIcon}" Width="13" Height="13" />
                    <Image Source="{Binding VerifiedIcon}" Width="13" Height="13" />
                  </StackPanel>
                  <Image Grid.Column="2" Source="{Binding PlanIcon}" Width="14" Height="14" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="18,18,18,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Image Source="avares://Trackify/Assets/Icons/online.png" Width="12" Height="12" />
          <TextBlock Text="ryan" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="Listening to: Neon Tide" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Classes="pill" Content="Unfriend" />
      </Grid>
      <ItemsControl Name="Msgs" Grid.Row="1" Margin="0,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,12" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Image Source="{Binding PlanIcon}" Width="12" Height="12" />
                <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="13" />
                <Image Source="{Binding RoleIcon}" Width="13" Height="13" />
                <Image Source="{Binding VerifiedIcon}" Width="13" Height="13" />
                <TextBlock Classes="muted" Text="{Binding Time}" />
              </StackPanel>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Watermark="Type a message here" Height="42" VerticalContentAlignment="Center" />
        <Button Grid.Column="1" Classes="accent" Width="42" Height="42"><Image Source="avares://Trackify/Assets/Icons/next.png" Width="18" Height="18" /></Button>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
