<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Trackify.Controls" x:Class="Trackify.Views.PlansPage" Classes="page">
  <ScrollViewer Padding="28,22,18,20">
    <StackPanel Spacing="16">
      <TextBlock Classes="h1" Text="Plans" />
      <TextBlock Classes="muted" FontSize="13" Text="Every paid plan lasts 3 days. Pay with § earned by listening." />
      <ItemsControl Name="Items">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="196" Padding="16" Margin="0,0,14,14">
              <StackPanel Spacing="10">
                <c:SpriteIcon Source="{Binding Sprite}" Width="64" Height="64" HorizontalAlignment="Left" />
                <TextBlock Classes="h2" Text="{Binding Name}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="avares://Trackify/Assets/Icons/token.png" Width="22" Height="22" />
                  <TextBlock Text="{Binding PriceNumber}" FontSize="22" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Classes="muted" Text="3 days" />
                <TextBlock Text="{Binding Features}" TextWrapping="Wrap" FontSize="12" Foreground="#C9C9D1" MinHeight="110" />
                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Binding Button}" IsEnabled="{Binding !Active}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
