<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Trackify.Controls" x:Class="Trackify.Views.GamesPage" Classes="page">
  <ScrollViewer Padding="28,22,18,20">
    <StackPanel Spacing="16">
      <TextBlock Classes="h1" Text="Games" />
      <ItemsControl Name="Items">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="200" Padding="16" Margin="0,0,14,14">
              <StackPanel Spacing="10">
                <Border Width="64" Height="64" CornerRadius="12" Background="#2A2A32" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource PixelFont}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Classes="h2" Text="{Binding Name}" />
                <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" MinHeight="48" />
                <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Play" Click="OnPlay" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Name="GameZone" Classes="flat" Padding="20" IsVisible="False">
        <StackPanel Spacing="12">
          <TextBlock Name="GameTitle" Classes="h2" />
          <TextBlock Name="GameHint" Classes="muted" />
          <Button Name="GameButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="18" FontSize="18" Click="OnGameClick" />
          <TextBlock Name="GameResult" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>