<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Trackify.Controls.TrackCard">
  <Border Classes="card" Width="176" Padding="0" Margin="0,0,14,14" Cursor="Hand" PointerPressed="OnClick">
    <StackPanel>
      <Border Height="118" Background="{Binding Color}" CornerRadius="14,14,0,0">
        <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource PixelFont}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B3FFFFFF" />
      </Border>
      <StackPanel Margin="12,10,12,12" Spacing="2">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="muted" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="muted" Text="{Binding Duration}" FontSize="11" />
          <TextBlock Classes="muted" Text="· TrackCloud" FontSize="11" />
          <TextBlock Text="OFFLINE" FontSize="10" Foreground="#4ADE80" IsVisible="{Binding IsOffline}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>