<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Trackify.Controls" x:Class="Trackify.Views.PlaylistsPage" Classes="page">
  <ScrollViewer Padding="28,22,18,20">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="Add Playlist" />
          <TextBlock Classes="muted" Text="Free plan: 3 of 3 playlists" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Classes="accent" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="avares://Trackify/Assets/Icons/add.png" Width="14" Height="14" />
            <TextBlock Text="New playlist" />
          </StackPanel>
        </Button>
      </Grid>
      <ItemsControl Name="Lists">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><c:TrackCard /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
